# This is a template file to document and provide a consistent template for new classes.  
# Common Features can be found in the class_feature_template file in the same directory.
# <placeholders> are named place holders.  There should be no <> in the final file.
# capitalized <Placeholders> represent title cased text strings and the replacements should be capitalized.

# create the class
unit: class/<edition>/<class>
in: class
group: "_{<Book>}"
name: "_{<Class>}"

# Set up the form for the character sheet builder
form:
  # Allow users to select one (or more) subclasses.  Each list of subclasses needs its own "select" entry (wizard thesis + school)
  - select: <class>/<subclass>
    name: "_{<Class's> <Subcless>}"
    max: 1
  # Allow users to preselect feats they have taken to prefill actions / feat slots.  (Not currently implemented?)  
  # Also sets the advancement page's class feat check boxes.
  - select: feat/<class>
    name: "_{<Class's> Feats}"
    max: 10
    levels: [ 1, 2, 4, 6, 8, 10, 14, 16, 18, 20 ]

require:
  # what levels does the class get weapon specialization (typically martials fast, casters slow)
  - unit: weapon-spec/fast
  - unit: weapon-spec/slow

  # Casters need spellbooks
  - unit: option/spellbook
  - unit: option/spellbook/custom

  # If the user chose to include a reference card, include the class reference.
  - with: option/reference
    unit: class/<class>/reference

  # don't let them take the class a second time as an archtype or their pre remaster as a multiclass
  - deny: class/<class>
  - deny: archetype/<class>
  - deny: archetype/remaster/<class>

  # spontaneous casters need to add spells to the list of things they can retrain on level up.
  - with: option/level-up
    unit: option/level-up/spell-retraining

  # include any feats or spells they will need to reference:
  - unit: <type>/<identifier>

# Now actually Build the class
inc:
  # Set the key ability if it only has one.  (Ignore if player can select.)
  - set: key-ability
    value: "<ABL>"   
        
  # Call protoytpe to set various proficiencies and labels
  - paste: prototype-class
    params:
      class: <class>
      class-name: "_{<Class>}"
      hp: 8
      subclass-name: "_{<Subclass_Name>}"

      # attack / defence DCs.  Options are trained / expert / master / legendary (no "") 
      # params: spells / unarmoured / light-armour / medium-armour / heavy-armour
      # unimplemented params: unarmed / simple-weapons / martial-weapons / advanced-weapons
      spells: trained
      unarmoured: trained
      unarmed: trained

      # perception proficiency
      perception: trained

      # skill proficiency
      religion: trained

      # save proficiencies
      fortitude: trained
      reflex: trained
      will: expert

  # Add common skill actions for the class. (See defs/skill-actions for complete list) 
  - at: '@skill-actions'
    add:
      - paste: skill-action/identify-magic
        params: 
          skill: "_{Occultism/other}"
          ability: INT
      - paste: skill-action/track

  # Build the level up page
  - at: '@advancement'
    add:
      # These do not need to be in level order.  Multiple items can be added to each level.

      # single feature gained at a single level that requires player to make a choice or update something (adds a check box)
      - level: <Number>
        gain: "_{<Feature>}"

      # single feature gained at a single level 
      - level: <Number>
        advance: "_{<Feature>}"

      # add a scaling feature in it's own column (must have - at: '@advancement-fields' (see below))
      - levels: [ <comma sepearted list of levels> ]
        <column-key>: [ <comma seperated list of strings> ]

      # add a scaling feature in it's own column with checkboxes (must have - at: '@advancement-fields' format: checkgrid (see below))
      - levels: [ <comma sepearted list of levels> ]
        <column-string-key>: [ <comma seperated list of strings> ]
        <column-num-key>: [ <comma seperated list of number of check boxes> ]
        
      # add a proficiency or proficiency increase.
      - level: <Number>
        advance: "_{<Proficiency Desc>}"
        proficiency: <rank>
        colour: <ABL> # (Optional)
      # or
      - level: <Number>
        proficiency: <rank>
        in: "_{<Proficiency Desc>}"
        colour: <ABL> # (Optional)

  # add a column for a scaling feature with a string at each level
  - at: '@advancement-fields'
    add:
      - name: "_{<Feature>}"
        key: <column-key>
        format: string

  # add a column for a scaling feature with a string and checkboxes at each level
  - at: '@advancement-fields'
    add:
      - name: "_{<Feature>}"
        key: <column-key>
        format: checkgrid
        label: "#{<column-string-key>}"
        max: "#{<column-num-key>}"

  # add the saving throw success upgrades to the savingt throw section of the combat sheet.
  - at: '@saving-throws'
    add:
      # upgrade success to crit success
      - level: <Number>
        contents:
          - paste: improved-save-<ref/fort/will>
            params:
              title: "_{<Feature>}"
          - p: "_{Special note}" # optional

      # upgrade crit fail to fail (optional - half damage on fail)
      - level: <Number>
        contents:
          - paste: improved-save-<ref/fort/will>-2
            params:
              title: "_{<Feature>}"
              half-damage: <true/false> # defaults to true.
          - p: "_{Special note}" # optional

