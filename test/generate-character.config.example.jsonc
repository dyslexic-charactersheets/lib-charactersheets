// reference copy of generate-character.config.json
{
  "game": "pathfinder2remaster",
  "identity": {
    "name": "generated-character",

    "ancestry": "orc",

    "heritages": {
      "catfolk": "clawed",
      "dwarf": "ancient-blooded",
      "elf": "ancient",
      "gnome": "chameleon",
      "goblin": "charhide",
      "halfling": "gutsy",
      "hobgoblin": "elfbane",
      "human": "skilled",
      "kholo": "ant",
      "kobold": "cavernstalker",
      "leshy": "cactus",
      "lizardfolk": "cliffscale",
      "orc": "rainfall",
      "ratfolk": "deep",
      "tengu": "dogtooth",
      "tripkee": "poisonhide"
    },

    "background": "cultist",

    "classes": ["druid"],

    "subclasses": {
      "alchemist": "bomber",
      "barbarian": "animal",
      "bard": "enigma",
      "champion": ["desecration", "armament"],
      "cleric": "cloistered",
      "druid": "animal",
      "investigator": "alchemical-sciences",
      "monk": "cobra",
      "oracle": "ancestors",
      "ranger": "flurry",
      "rogue": "mastermind",
      "sorcerer": "aberrant",
      "swashbuckler": "battledancer",
      "witch": "faiths-flamekeeper",
      "wizard": ["experimental-spellshaping", "ars-grammatica"]
    },

    "feats": ["diehard"],
    "archetypes": [],
    "language": "en"
  },

  "attributes": {

    // full = one full page
    // both = half page + full page
    // double = full page + an extra overflow page
    // default = the half-page inventory.
    "inventoryStyle": "double",

    "optionCover": true,                      // cover page 
    "optionPermission": false,                // "Permission to Print" licensing page
    "optionReference": false,                 // rules-reference page
    "optionBuild": false,                     // step-by-step "Build A Character"
    "optionMinis": false,                     // GM-screen hanger + foldable mini stand/standee page
    "optionCharacterBackground": true,        // extended backstory page
    "optionLevelUp": true,                    // "Level Up" page + advancement table
    "optionPfs": false,                       // Pathfinder Society fields
    "optionAncestryParagon": false,           // Gamemastery Guide variant: expanded Ancestry Paragon layout
    "optionAutomaticBonusProgression": false, // Gamemastery Guide variant: ABP potency instead of magic items

    // colour-codes attribute-linked stats/icons
    "optionColourful": true,

    // physical mini-stand size embedded by optionMinis (small/medium/large)
    "miniSize": "small",

    // theme colours
    "printColour": "#241428",
    "accentColour": "#a6085e",

    // dyslexia-friendly font
    "printDyslexic": false,
    "printDyslexie": true,

    // cover-page logo
    "printLogo": "logos/pathfinder2e.png",

    // portraits
    "printPortrait": "portraits/Gnome Noole.png",
    "animalPortrait": "portraits/large_riding_dog.jpg",

    // cover-page background
    "printBackground": "backgrounds/paper3.jpg"
  },

  // any fillable character fields to override, check HTML or --dump-fields json
  "fields": {}
}
